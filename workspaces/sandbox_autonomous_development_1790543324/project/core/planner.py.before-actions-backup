import json
from core.router import AIRouter


class IRISPlanner:

    def __init__(self):
        self.router = AIRouter()

    def build_prompt(self, request: str) -> str:
        return f"""
You are the task planner for IRIS, a personal AI computer assistant.

USER REQUEST:
{request}

AVAILABLE TOOLS:
- search_web
- read_webpage
- run_powershell
- run_python
- create_file
- read_file
- list_files
- read_document
- create_excel
- remember
- search_memory
- list_memories

TASK TYPES:
- answer
- research
- computer
- python
- file
- memory
- multi_step

RULES:
1. Identify the user's actual objective.
2. Select only the tools necessary.
3. Use search_web for current internet information.
4. Use read_webpage when search results need inspection.
5. Use run_powershell for Windows operations.
6. Use run_python for Python execution.
7. Use file tools for file/document tasks.
8. Use multi_step when multiple operations are necessary.
9. Never invent tools.
10. Do not execute anything.
11. Return ONLY valid JSON.

JSON FORMAT:
{{
  "task_type": "answer|research|computer|python|file|memory|multi_step",
  "objective": "short description",
  "tools": [
    {{
      "name": "tool_name",
      "purpose": "why this tool is needed"
    }}
  ],
  "requires_verification": true,
  "risk": "low|medium|high"
}}
"""

    def plan(self, request: str) -> dict:

        result = self.router.compare(self.build_prompt(request))
        final = result.get("final", "").strip()

        try:
            start = final.find("{")
            end = final.rfind("}")

            if start == -1 or end == -1:
                raise ValueError("No JSON object found.")

            data = json.loads(final[start:end + 1])

            if not isinstance(data, dict):
                raise ValueError("Planner response is not an object.")

            data.setdefault("tools", [])
            data.setdefault("requires_verification", True)
            data.setdefault("risk", "medium")

            return data

        except Exception as e:
            return {
                "task_type": "answer",
                "objective": request,
                "tools": [],
                "requires_verification": True,
                "risk": "low",
                "planner_error": str(e)
            }
