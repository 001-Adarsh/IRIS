from datetime import datetime
from core.router import AIRouter
from core.researcher import WebResearcher
from core.synthesizer import AISynthesizer
from core.planner import IRISPlanner
from core.executor import IRISExecutor
from core.verifier import IRISVerifier
from tools.manager import ToolManager
from core.development_workflow import IRISDevelopmentWorkflow


class IRISAgent:

    MAX_TASK_STEPS = 3

    def __init__(self):
        self.router = AIRouter()
        self.tools = ToolManager()
        self.researcher = WebResearcher()
        self.synthesizer = AISynthesizer()
        self.planner = IRISPlanner()
        self.executor = IRISExecutor(self.tools)
        self.verifier = IRISVerifier()
        self.development = IRISDevelopmentWorkflow()
        self.task_state = IRISTaskState()
        self.task_verifier = IRISTaskVerifier()

    def run(self, prompt: str):

        p = prompt.lower().strip()

        if p in ["exit", "quit", "/bye", "/exit", "/quit"]:
            return "__IRIS_EXIT__"

        # Autonomous development
        development_triggers = [
            "develop ",
            "build ",
            "implement ",
            "create a feature",
            "add a feature",
            "improve iris",
            "upgrade iris",
            "modify iris",
            "change iris"
        ]

        is_development_request = (
            p in {
                "develop",
                "build",
                "implement",
                "improve iris",
                "upgrade iris",
                "modify iris",
                "change iris"
            }
            or any(p.startswith(x) for x in development_triggers)
        )

        if is_development_request:
            objective = prompt.strip()

            print("\nIRIS Development Mode: Starting...")

            result = self.development.develop(objective)

            if not result.get("success"):
                return (
                    "IRIS development could not complete safely.\n\n"
                    f"Reason: {result.get('reason', 'Unknown error')}\n"
                    f"Production modified: {result.get('production_modified', False)}"
                )

            proposal = result.get("proposal", {})

            return (
                "=== IRIS DEVELOPMENT COMPLETE ===\n\n"
                f"Objective: {result.get('objective')}\n"
                f"Sandbox: {result.get('workspace')}\n"
                f"Project: {result.get('project')}\n"
                f"Changes: {', '.join(result.get('changes', []))}\n"
                f"Tests passed: {result.get('tests', {}).get('passed')}\n\n"
                "Production modified: NO\n"
                "Production deployment: APPROVAL REQUIRED\n"
                f"Upgrade proposal: {proposal.get('proposal_file', 'Not created')}"
            )
        # Explicit research
        research_triggers = [
            "research the internet",
            "research internet",
            "research web",
            "research online",
            "research",
            "find out about",
            "find out"
        ]

        if any(p.startswith(x) for x in research_triggers):

            query = prompt

            phrases = [
                "research the internet for",
                "research the internet",
                "research internet for",
                "research internet",
                "research web for",
                "research web",
                "research online for",
                "research online",
                "research for",
                "research",
                "find out about",
                "find out"
            ]

            for phrase in phrases:
                if query.lower().startswith(phrase):
                    query = query[len(phrase):].strip()
                    break

            if not query:
                return "Please provide a research topic."

            research = self.researcher.research(
                query,
                max_sources=3
            )

            if not research.get("evidence"):
                return "IRIS could not find usable evidence."

            print(
                "\nIRIS AI Synthesizer: Creating final answer..."
            )

            return self.synthesizer.synthesize(
                query,
                research
            )

        # Explicit web search
        search_triggers = [
            "search the internet",
            "search internet",
            "search in internet",
            "search online",
            "search web"
        ]

        if any(p.startswith(x) for x in search_triggers):

            query = prompt

            phrases = [
                "search the internet for",
                "search the internet",
                "search internet for",
                "search internet",
                "search in internet for",
                "search in internet",
                "search online for",
                "search online",
                "search web for",
                "search web"
            ]

            for phrase in phrases:
                if query.lower().startswith(phrase):
                    query = query[len(phrase):].strip()
                    break

            if not query:
                return "Please provide a search query."

            results = self.tools.execute(
                "search_web",
                query=query,
                max_results=5
            )

            if not results:
                return "No web results found."

            output = ["=== IRIS WEB SEARCH ==="]

            for i, result in enumerate(results, 1):
                output.append(
                    f"\n[{i}] {result['title']}\n"
                    f"URL: {result['url']}\n"
                    f"INFO: {result['snippet']}"
                )

            return "\n".join(output)

        # Memory
        if p.startswith("remember ") or p.startswith("remember:"):

            memory = prompt

            if memory.lower().startswith("remember:"):
                memory = memory[len("remember:"):].strip()

            elif memory.lower().startswith("remember "):
                memory = memory[len("remember "):].strip()

            if memory.lower().startswith("that "):
                memory = memory[5:].strip()

            if not memory:
                return "Please provide something for me to remember."

            return self.tools.execute(
                "remember",
                content=memory
            )

        if (
            p.startswith("what do you remember")
            or p.startswith("search memory")
            or p.startswith("recall ")
        ):

            query = prompt

            phrases = [
                "what do you remember about",
                "what do you remember",
                "search memory",
                "recall"
            ]

            for phrase in phrases:
                if query.lower().startswith(phrase):
                    query = query[len(phrase):].strip()
                    break

            query = query.strip(" ?!.,:;")

            if not query:
                return "Please tell me what you want me to remember."

            results = self.tools.execute(
                "search_memory",
                query=query
            )

            if not results:
                return "I don't have any matching memories."

            return "\n".join(
                f"- {item[1]}"
                for item in results
            )

        if p in [
            "list memories",
            "show memories",
            "show my memories"
        ]:

            results = self.tools.execute(
                "list_memories"
            )

            if not results:
                return "I don't have any saved memories."

            return "\n".join(
                f"- {item[1]}"
                for item in results
            )

        # Automatic memory
        automatic_memory_triggers = [
            "my name is ",
            "i am ",
            "i'm ",
            "i work ",
            "i work at ",
            "i live ",
            "i prefer ",
            "i like ",
            "i dislike ",
            "i'm learning ",
            "i am learning ",
            "my goal is ",
            "my laptop is "
        ]

        memory_text = prompt.strip()

        if any(
            memory_text.lower().startswith(trigger)
            for trigger in automatic_memory_triggers
        ):

            result = self.tools.execute(
                "remember",
                content=memory_text
            )

            return (
                "I'll remember that.\n"
                f"{result}"
            )

        # Explicit PowerShell
        if (
            p.startswith("run powershell")
            or p.startswith("powershell")
            or p.startswith("check my computer")
        ):

            command = prompt

            phrases = [
                "run powershell",
                "powershell",
                "check my computer"
            ]

            for phrase in phrases:
                if command.lower().startswith(phrase):
                    command = command[len(phrase):].strip()
                    break

            if not command:
                return "Please provide a PowerShell command."

            return self.tools.execute(
                "run_powershell",
                command=command
            )

        # Explicit Python
        if (
            p.startswith("run python")
            or p.startswith("python")
        ):

            code = prompt

            phrases = [
                "run python",
                "python"
            ]

            for phrase in phrases:
                if code.lower().startswith(phrase):
                    code = code[len(phrase):].strip()
                    break

            if not code:
                return "Please provide Python code."

            return self.tools.execute(
                "run_python",
                code=code
            )

        # ==============================
        # ==============================
        # Task state initialization
        # ==============================

        task_id = "TASK-" + datetime.now().strftime("%Y%m%d_%H%M%S_%f")

        task_state = self.task_state.create(
            task_id,
            prompt
        )

        print("\nIRIS Task ID: " + task_id)
        # Deterministic system RAM route
        # ==============================

        ram_phrases = [
            "check how much physical ram",
            "check physical ram",
            "how much physical ram",
            "how much ram does this computer have",
            "how much ram does my computer have",
            "how much ram do i have",
            "check my ram",
            "check ram",
            "show my ram",
            "show physical ram",
            "system ram",
            "physical memory"
        ]

        normalized_prompt = " ".join(
            prompt.lower().strip().split()
        )

        if any(
            phrase in normalized_prompt
            for phrase in ram_phrases
        ):
            print("\nIRIS System RAM Route: Detected")

            ram_command = (
                "Get-CimInstance Win32_ComputerSystem "
                "| Select-Object TotalPhysicalMemory"
            )

            print(
                "IRIS System RAM Route: "
                "Using approved PowerShell query."
            )

            ram_result = self.tools.execute(
                "run_powershell",
                command=ram_command
            )

            print(
                "\n=== IRIS RAM RESULT ==="
            )
            print(ram_result)

            if isinstance(ram_result, dict):
                result_text = str(
                    ram_result.get("result", "")
                )
            else:
                result_text = str(ram_result)

            if "TotalPhysicalMemory" in result_text:
                self.task_state.update(
                    task_id,
                    status="completed",
                    step=1,
                    attempts=1,
                    last_tool="run_powershell",
                    last_result=result_text,
                    verification={
                        "verified": True,
                        "reason": (
                            "Physical RAM was successfully "
                            "retrieved using the approved "
                            "system-information query."
                        )
                    },
                    next_action=None
                )

                return (
                    "=== PHYSICAL RAM ===\n"
                    f"{result_text}"
                )

            self.task_state.update(
                task_id,
                status="failed",
                step=1,
                attempts=1,
                last_tool="run_powershell",
                last_result=result_text,
                verification={
                    "verified": False,
                    "reason": (
                        "RAM query did not return "
                        "TotalPhysicalMemory."
                    )
                },
                next_action=None
            )

            return (
                "IRIS could not verify the physical RAM result.\n"
                f"{result_text}"
            )
        # ==============================
        # IRIS AUTONOMOUS TASK LOOP
        # ==============================

        print("\nIRIS Task Loop: Starting...")

        history = []

        for step in range(1, self.MAX_TASK_STEPS + 1):
            self.task_state.update(
                task_id,
                status="planning",
                step=step,
                attempts=step
            )

            print(
                f"\nIRIS Task Loop: Step {step}/{self.MAX_TASK_STEPS}"
            )

            plan = self.planner.plan(
                prompt,
                previous_attempts=history
            )

            print(
                f"IRIS Planner selected task: "
                f"{plan.get('task_type', 'unknown')}"
            )

            selected_tools = plan.get("tools", [])

            if not selected_tools:

                print(
                    "IRIS Planner selected no executable tools."
                )

                break

            for tool in selected_tools:

                print(
                    f"- {tool.get('name')}: "
                    f"{tool.get('purpose')}"
                )

                arguments = tool.get(
                    "arguments",
                    {}
                )

                if arguments:
                    print(
                        f"  arguments: {arguments}"
                    )

            # Always verify autonomous tool execution.
            plan["requires_verification"] = True

            execution = self.executor.execute_plan(
                plan
            )

            if not execution.get("success"):

                history.append({
                    "step": step,
                    "plan": plan,
                    "execution": execution,
                    "verification": {
                        "verified": False,
                        "reason": "Execution failed."
                    }
                })

                self.task_state.update(
                    task_id,
                    status="replanning",
                    step=step,
                    attempts=step,
                    last_result=execution,
                    verification={
                        "verified": False,
                        "reason": "Execution failed."
                    },
                    next_action="Replan after execution failure."
                )

                print(
                    "IRIS Executor: Execution failed."
                )

                break

            print(
                "\nIRIS Executor: Task executed."
            )

            # First run the existing verifier for compatibility.
            base_verification = self.verifier.verify(
                prompt,
                execution
            )

            # Then verify the actual objective against each executed tool.
            task_verifications = []

            for result in execution.get("results", []):
                tool_name = result.get("tool", "")
                arguments = result.get("arguments", {})

                task_verification = self.task_verifier.verify(
                    prompt,
                    tool_name,
                    arguments,
                    result.get("result")
                )

                task_verifications.append(task_verification)

            if task_verifications:
                verification = {
                    "verified": all(
                        item.get("passed", False)
                        for item in task_verifications
                    ),
                    "reason": "; ".join(
                        item.get("reason", "")
                        for item in task_verifications
                    ),
                    "task_verifications": task_verifications,
                    "base_verification": base_verification
                }
            else:
                verification = {
                    "verified": False,
                    "reason": "No executable tool results were produced.",
                    "task_verifications": [],
                    "base_verification": base_verification
                }

            self.task_state.update(
                task_id,
                status=(
                    "completed"
                    if verification["verified"]
                    else "replanning"
                ),
                step=step,
                attempts=step,
                verification=verification,
                next_action=(
                    None
                    if verification["verified"]
                    else "Replan task with previous attempt results."
                )
            )

            print(
                f"IRIS Task Verifier: "
                f"{verification.get('reason')}"
            )

            for result in execution.get("results", []):

                history.append({
                    "step": step,
                    "tool": result.get("tool"),
                    "arguments": (
                        next(
                            (
                                t.get("arguments", {})
                                for t in selected_tools
                                if t.get("name") == result.get("tool")
                            ),
                            {}
                        )
                    ),
                    "result": result.get("result"),
                    "verification": verification.get("reason")
                })

            if verification.get("verified"):

                self.task_state.complete(
                    task_id,
                    execution
                )

                output = []

                for result in execution.get(
                    "results",
                    []
                ):

                    if result.get("success"):

                        output.append(
                            f"=== {result['tool']} RESULT ===\n"
                            f"{result['result']}"
                        )

                if output:

                    return "\n\n".join(output)

            print(
                "IRIS Task Loop: Result incomplete. "
                "Planning another step..."
            )

        print(
            "\nIRIS Task Loop: Unable to complete "
            "the requested task."
        )

        return self.router.route(prompt)

